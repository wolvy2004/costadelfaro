---
import Menu from "./Menu.astro";
import Logo from "./Logo.astro";
import LogoH from "./Logo_h.astro";
import { Icon } from "astro-icon/components";
const { links } = Astro.props;
---

<script>
  let menu_lateral = document.getElementById("menu-lateral");
  let links = document.getElementsByClassName("link");
  let btn_menu_close = document.getElementById("menu-lateral-close");
  let menu_activador = document.querySelector(".menu-lateral-active");

  Array.from(links).forEach((element) => {
    element.addEventListener("click", () => {
      if (menu_lateral) {
        menu_lateral.style.transform = "translateX(300px)";
      }
    });
  });
  menu_activador?.addEventListener("click", () => {
    if (menu_lateral) {
      menu_lateral.style.transform = "translateX(0px)";
    }
  });
  btn_menu_close?.addEventListener("click", () => {
    if (menu_lateral) {
      menu_lateral.style.transform = "translateX(300px)";
    }
  });
  window.addEventListener("scroll", () => {
    const scroll: number = window.scrollY;
    const cabecera = document.querySelector(".cabecera");
    if (cabecera) {
      if (scroll > 0) {
        cabecera.classList.add("scroll");
      } else {
        cabecera.classList.remove("scroll");
      }
    }
  });
</script>

<header class="cabecera">
  <section class="content-menu">
    <div id="logo"><Logo /></div>
    <div id="logo_h"><img src="src/assets/logo_h.png" alt="" /></div>

    <Menu id="menu" links={links} />
    <Icon name="mdi:menu" width="32" height="32" class="menu-lateral-active" />
  </section>
</header>
<style scoped>
  * {
    padding: 0;
    margin: 0;
    box-sizing: content-box;
  }
  .menu-lateral-active {
    display: none;
  }
  .cabecera {
    background: linear-gradient(#fff 20%, transparent);
    width: 100%;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    margin: 0 auto;
    position: fixed;
    z-index: 99;
    transition: ease-in 0.5s all;
  }
  .content-menu {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 35px;
  }

  #logo {
    opacity: 1;
    z-index: 40;
    scale: 1;
    transition: 1s ease-in-out all;
    transition-delay: 1s;
  }
  #logo_h {
    display: none;
    padding: 0.75rem 1.5rem;
    opacity: 0;
    width: 350px;
    height: 50px;
    transform: translateY(-10px);
    transition: 0.5s ease-in-out all;
  }

  .scroll {
    display: flex;
    height: 95px;
    opacity: 1;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(20px);
    box-shadow: 0px 5px 25px 10px rgba(0, 0, 0, 0.2);
    .menu {
      background-color: transparent;
    }
    .content-menu {
      margin: 0 auto;
    }
    #logo {
      opacity: 0;
      display: none;
    }
    #logo_h {
      display: block;
      opacity: 1;
      transform: translateY(00px);
      z-index: 99;
    }
  }
  @media (max-width: 1280px) {
    .menu {
      background-color: transparent;
    }
    .menu-lateral-active {
      display: block;
    }
    .content-menu {
      margin: 0 4rem;
      display: flex;
      justify-content: space-between;
    }

    #logo_h {
      position: absolute;
      top: 0;
      left: 50px;
      opacity: 1;
      z-index: 40;
      margin-left: 0em;
      scale: 1;
      transition: 1s ease-in-out all;
      transition-delay: 1s;
    }
  }
  @media (max-width: 640px) {
    .menu-lateral-active {
      display: block;
      margin: 2rem;
    }
    .content-menu {
      margin: 0;
      display: flex;
      align-items: start;
      justify-content: space-between;
    }

    #logo {
      opacity: 1;
      z-index: 40;
      scale: 0.8;
      transition: 1s ease-in-out all;
      transition-delay: 1s;
    }
    #logo_h {
      top: 10px;
      opacity: 1;
      padding: 0;
      transform: translateX(-30%);
      z-index: 40;
      scale: 0.75;
      transition: 1s ease-in-out all;
      transition-delay: 1s;
    }
  }
</style>
