---
interface enlace {
  type: string;
}
const { enlace, active } = Astro.props;
---

<li class="link" class:list={[{ active: enlace == "Home" }]}>
  <a href={"#" + enlace}>{enlace}</a>
  <div class="line"></div>
</li>

<style scoped>
  .link {
    background-color: none;
    border-radius: 9px;
    gap: 100px;
    font-size: 0.8em;
    text-transform: uppercase;
    text-align: center;
    cursor: pointer;
    list-style: none;
    margin: auto;
    a {
      text-transform: uppercase;
      color: #333;
      &:hover{
        text-transform: uppercase;
      color: white;
      }
    }
    
  }

  .active a {
    color: var(--var-color-green500);
    font-weight: 900;
    text-transform: uppercase;
  }
  .line {
    height: 0px;
    width: 0%;
    transition: 1s ease all;
  }
  .active .line {
    height: 4px;
    width: 100%;
    background-color: var(--var-color-acent);
  }
  @media (max-width: 1280px) {
    .link {
    border-radius: 0px;
    font-size: 1.25em;
    text-transform: uppercase;
    text-align: center;
    cursor: pointer;
    list-style: none;
    margin: auto;
    &:hover{
        color: white;
    }
    a {
      display: block;
      color: var(--var-color-green000);
      &:hover{
        background-color: var(--var-color-green700);
        color: white;
      }
    }
     
  }
  .active {
    color: wheat
    font-weight: 900;
  }
   .active a {
    color: wheat
    font-weight: 900;
  }
  .line {
    height: 0px;
    width: 0%;
    transition: 1s ease all;
  }
  .active .line {  
    height: 0;  
    
    
  }
}

 
</style>
