---

interface links {
  type: Array<String>;
}
import Link from "./Link.astro";
const { links } = Astro.props;
import { Icon } from "astro-icon/components";
---


  
<nav class="menu" >
 
  <ul>
    
    {links.map((link: string) => <Link enlace={link} active=true />)}
  </ul>
</nav>

<nav class="menu-lateral" id="menu-lateral">
  <Icon name="mdi:close" id="menu-lateral-close" width=32 height=32></Icon>
  <ul>
   
    {links.map((link: string) => <Link enlace={link} active=true />)}
  </ul>
</nav>
<style scoped>
  .menu {
      z-index: 99;
      justify-content: end;
      align-items: center;
      padding: 1rem;
      height: 75px;
      transition: 1s ease-in-out all;
    }
  .menu ul {
    display: flex;
    flex-direction: row;
    gap: 25px;
    
  }
  #menu-lateral-close{
    border: 2px solid white;
    border-radius: 50%;
    margin: 2rem;
    padding: 0.2rem;
    color: white;
  }
  .menu-lateral{
    display: none;
  }
  
  @media (max-width:1280px) {
   .menu{
    display: none;
      
    }
    .menu-lateral{
      display: flex;
      justify-content: end;
      align-items: end;
      z-index: 99;
      display: none;
      position: absolute;
      width: 300px;
      top: 0px;
      right: 0;
      height: 100dvh;
      background-color: rgba(2, 64, 64, 0.7);
      backdrop-filter: blur(10px);
      box-shadow: inset   -20px 0px 25px 0px rgba(1, 46, 40, 0.5);
    }
    .menu-lateral ul{
      margin-top: 25px;
      right: 0;
      display: flex;
      flex-direction: column;
      gap: 15px;
      
      li{
        padding: 0.5rem;
        border-radius: 0;
        width: 100%;
        color: white;
      
      }
    }
    
    
  }
</style>
