          alt="apart 2 personas"
          width="500"
          height="150"
        />
      </div>
      <div class="descripcion">
        <h1 class="title">Aparts para 2 personas</h1>
        <p class="subtitle">
          Detalle del apart con una breve descripcion del mismo
        </p>
        <div class="icon-servicios">
          <div class="item-descripcion">
            <Icon class="icon" name="mdi:bed" width="32" height="32/" />
            <p class="text-icon">Sommier matrimonial</p>
          </div>
          <div class="item-descripcion">
            <Icon class="icon" name="mdi:television" width="32" height="32/" />
            <p>TV LED</p>
          </div>
          <div class="item-descripcion">
            <Icon class="icon" name="mdi:coffee" width="32" height="32/" />
            <p>Desayuno Seco</p>
          </div>
          <div class="item-descripcion">
            <Icon class="icon" name="mdi:wifi" width="32" height="32/" />
            <p>Conexion WiFi</p>
          </div>
          <div class="item-descripcion">
            <Icon class="icon" name="mdi:account" width="32" height="32/" />
            <p>2 Personas</p>
          </div>
          <div class="item-descripcion">
            <Icon class="icon" name="mdi:car" width="32" height="32/" />
            <p>Cochera incluida</p>
          </div>
        </div>

        <button class="boton-reserva">
          <Icon class="icon" name="mdi:bag-suitcase" width="32" height="32" />
