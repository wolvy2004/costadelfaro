<style scoped>
  #Aparts {
    background-color: #f6f6f6;
    padding: 0px;
    margin: 0 auto;

    box-shadow: 0 0 50px 5px rgba(1, 1, 1, 0.5);
  }
  .icon-servicios {
    margin: 2rem 1rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    flex-direction: row;
  }
  .item-descripcion {
    display: flex;
    gap: 25px;
    height: 30px;
    .icon {
      width: 40px;
      height: 40px;
      background-color: var(--var-color-grey100);
      padding: 0.25rem;
      border-radius: 7px;
      transition: 0.5s ease-in-out all;
      color: var(--var-color-white);
      &:hover {
        background-color: var(--var-color-green400);
      }
    }
  }
  .imagen {
    overflow: hidden;
    height: clamp(150px, 100%, 100%);
  }
  .img {
    filter: grayscale(0.7);
    transform: scale(1);
    height: 100%;
    object-fit: cover;
    transition: ease-in-out 0.5s all;
    &:hover {
      filter: grayscale(0);
      transform: scale(1.2);
    }
  }
  .title-page {
    font-family: var(--var-font-title);
    text-align: center;
    position: relative;
    font-size: 7rem;
    color: var(--var-color-green400);
    margin-bottom: 2rem;
    &::before {
      content: "";
      top: 50%;
      left: 0;
      position: absolute;
      height: 3px;
      width: 30%;
      background-color: var(--var-color-grey100);
    }
    &::after {
      content: "";
      top: 50%;
      right: 0;
      position: absolute;
      height: 3px;
      width: 30%;
      background-color: var(--var-color-grey100);
    }
  }
  .content {
    margin: 0 auto;
    width: clamp(50%, 1400px, 1400px);
    height: max-content;
  }

  .card:nth-child(even) {
    background-color: var(--var-color-green000);
  }
  .card:nth-child(odd) {
    background-color: var(--var-color-white);
    flex-direction: row-reverse;
  }
  .card:nth-child(1) {
    flex-direction: row-reverse;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: row;
    height: 400px;
    width: clamp(100dvw, 1200px);
    .descripcion {
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;

      .title {
        font-family: var(--var-font-title);
        font-size: clamp(5rem, 2rem, 1rem);
        width: 100%;
      }
      .subtitle {
        color: var(--var-color-grey200);
        font-size: clamp(1rem, 0.5rem, 0.5rem);
        letter-spacing: 1px;
      }
    }

    .title {
      text-align: center;
      font-size: 1em;
      font-family: var(--var-font-type);
      color: var(--var-color-green400);
    }
  }
  .boton-reserva {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 1rem;
    margin: 1rem;
    padding: 0.5rem 2rem;
    border-radius: 10px;
    background: var(--var-color-brown);
    color: var(--var-color-amber);
    border: none;
    font-size: 1rem;
    text-transform: capitalize;
    transition: 0.3s ease-in-out;

    &:hover {
      background: var(--var-color-amber);
      color: var(--var-color-brown);
      scale: 1.1;
    }
  }
  @media (max-width:1024px){
    #Aparts, .content{
      width: 90%;
    }
    .descripcion .title{
      font-size: 4rem;
    }
    .title-page::after,
    .title-page::before {
      height: 1px;
      width: 15%;
    }

  }
  @media (max-width: 680px) {
    .title-page {
      font-size: 4rem;
      line-height: 2rem;
    }
    .title-page::after,
    .title-page::before {
      height: 0px;
    }
    .content {
      width: 100dvw;
      margin: 0 auto;      
    }
    .card{
      display: block;
      
    }
    .icon-servicios{
      display: none;
    }
    .imagen{
      height: 150px;
    }
    .boton-reserva {
      display: flex;
      border-radius: 10px;
      justify-content: space-around;
      border: none;
      text-transform: lowercase
      transition: 0.3s ease-in-out;
      text-align: center;
      
    }
    .descripcion {
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      justify-content: start;
      align-items: center;
      
      
      .title {
        font-size: var(--var-font-type) !important;
        font-size: 3rem !important;
      }
      .subtitle {
        color: var(--var-color-grey200);
        letter-spacing: 0px;
        padding: 0.5rem 0.75rem;
        text-align: center;
      }
    }
  }
</style>
