---
import ReservasBox from "../vue/ReservasBox.vue";
---

<section id="Home" class="w-full h-dvh">
  <h1 class="title sm:text-7xl lg:text-5xl xl:text-8xl md:text-7xl">
    Un Paraiso Frente al mar
  </h1>
  <p class="leyend md:text-sm sm:text-sm xs:text-xs xl:text-2xl">
    Lorem ipsum, dolor sit amet consectetur adipisicing elit. Repellendus alias
    dolor quos, quae dolores quidem omnis pariatur earum exercitationem neque
    voluptatem, magni deleniti. Unde placeat suscipit aut non cum ab.
  </p>
  <div class="bg_gradiente"></div>

  <!-- ventana modal-->
  <ReservasBox client:only class="sm:hidden xl:block" />

  <div class="white_space"></div>
</section>
<style scoped>
  .title {
    z-index: 51;
    font-family: var(--var-font-title);
    font-weight: 500;
    color: var(--var-color-white);
    position: absolute;
    bottom: 280px;
    text-align: center;
    width: 100%;
  }
  #Home {
    background-image: url("../../assets/bg_home.jpg");
    background-size: cover;
    background-position: center;
    .leyend {
      z-index: 50;
      position: absolute;
      bottom: 205px;
      width: 70%;
      text-align: center;
      left: 50%;
      transform: translateX(-50%);
      color: var(--var-color-white);
    }
  }
  .bg_gradiente {
    position: absolute;
    bottom: 0px;
    left: 0px;
    width: 100%;
    background: linear-gradient(
      0deg,
      var(--var-color-green700),
      15%,
      transparent
    );
    height: 90vh;
  }
  .white_space {
    position: absolute;
    width: 100%;
    height: 100px;
    background-color: var(--var-color-white);
    left: 0;
    bottom: 0;
  }
</style>
