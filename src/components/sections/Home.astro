---
import ReservasBox from "../vue/ReservasBox.vue";
import HomeHero from "../../assets/bg_home_hero.svg";
---

<section id="Home">
  <div class="leyend">
    <h1 class="title">Un Paraiso Frente al mar</h1>
    <p>
      El mejor lugar para descansar frente al mar, con todo lo que necesitas
      para disfrutar de nuestros hermosos paisajes y el clima
    </p>
  </div>
  <!-- ventana modal-->
  <div class="reservas-box">
    <ReservasBox client:only />
  </div>
  <img class="img-bottom" src={HomeHero.src} alt="formas_onduladas" />
</section>
<style scoped>
  .img-bottom {
    position: absolute;
    width: 100%;
    bottom: clamp(-280px, -180px, 90px);
  }
  #Home {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-image: url("../../assets/bg_home.jpg");
    background-size: cover;
    background-position: center;
    height: 100dvh;

    .leyend {
      position: absolute;
      bottom: 200px;
      z-index: 40;
      font-size: 1rem;
      text-align: center;
      color: var(--var-color-white);
      .title {
        z-index: 50;
        font-family: var(--var-font-title);
        font-size: 6rem;
        line-height: 6rem;
        color: var(--var-color-white);
        text-align: center;
      }
      p {
        width: clamp(90% 50% 70%);
      }
    }
  }

  @media (max-width: 1024px) {
    #Home {
      .leyend {
        position: absolute;
        bottom: 120px;
        width: 80dvw;
        .title {
          font-size: 3rem;
          width: 90dvw;
          line-height: 2rem;
          font-weight: 500;
        }
      }
    }
    .reservas-box {
      display: none;
    }
  }
  @media (max-width: 1440px) {
    .title {
      width: 100%;
    }
  }
  @media (max-width: 680px) {
    .reservas-box {
      display: none;
    }

    #Home {
      img {
        position: absolute;
      }
      .leyend {
        font-size: 1rem;
        position: absolute;
        bottom: 50px;
        width: 80dvw;
        .title {
          font-size: 3rem;
          line-height: 3rem;
          font-weight: 500;
        }
      }
    }
  }
</style>
