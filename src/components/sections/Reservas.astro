---
import { Icon } from "astro-icon/components";
import BgBottomServicios from "../../assets/bg_bottom_servicios.svg";
import BgTopContacto from "../../assets/bg_top_contacto.svg";
import imagenLateral from "../../assets/img-aparts-36.jpg";
---

<script>
  const fecha = new Date("10-12-2005");

  let input_fecha_desde = document.getElementById("fecha_desde");
  console.log(input_fecha_desde?.nodeValue);

  console.log(input_fecha_desde?.title);
  if (input_fecha_desde) {
  }

  const borrarCamposBoton = document.getElementById("btn-delete-fields");
  let formulario = document.getElementById("form-contact") as HTMLFormElement;

  borrarCamposBoton?.addEventListener("click", (e) => {
    e.preventDefault();
    formulario?.reset();
  });
