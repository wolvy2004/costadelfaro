<section id="Reservas" class="relative">
  <img
    src={BgBottomServicios.src}
    class="w-full absolute top-0 left-0 z-0"
    alt=""
  />

  <article class="content-reservas">
    <picture class="image">
      <img src={imagenLateral.src} />
    </picture>
    <div class="content-form">
      <h1 class="title-reservas">Reservas</h1>
      <form
        action="post"
        class="form-contact"
        id="form-contact"
        action="/api/send_email"
      >
        <fieldset>
          <div class="input-container sm:w-2 md:w-2/3 xl:w-full">
            <input type="text" id="name" required />
            <label for="name">Nombre y Apellido</label>
            <Icon name="mdi:user" width="20px" height="20px" class="icon" />
          </div>
          <div class="input-container">
            <input type="email" id="email" required />
            <label for="email">email</label>
            <Icon width="20px" height="20px" name="mdi:email" class="icon" />
          </div>
          <div class="input-container">
            <input type="tel" id="telefono" required />
            <label for="telefono">telefono de contacto</label>
            <Icon width="20px" height="20px" name="mdi:phone" class="icon" />
          </div>
          <div class="info-reserva">
            <div class="input-container">
              <input type="date" id="fecha_desde" />
              <label for="observaciones">desde</label>
              <Icon
                width="20px"
                height="20px"
                name="mdi:calendar"
                class="icon"
              />
            </div>
            <div class="input-container">
              <input type="date" id="fecha_hasta" />
              <label for="observaciones">hasta</label>
              <Icon
                width="20px"
                height="20px"
                name="mdi:calendar"
                class="icon"
              />
            </div>

            <div class="input-container">
              <input type="number" />
              <label for="cantidad_adultos">Adultos</label>
              <Icon width="24px" height="24px" name="mdi:person" class="icon" />
            </div>

            <div class="input-container">
              <input type="number" />
              <label for="cantidad_ninos">Menores</label>
              <Icon
                width="24px"
                height="24px"
                name="mdi:human-child"
                class="icon"
              />
            </div>
          </div>
        </fieldset>
        <fieldset>
          <div class="input-container">
            <textarea name="observaciones" id="observaciones"></textarea>
            <label for="observaciones">observaciones</label>
            <Icon width="16px" height="16px" name="mdi:pencil" class="icon" />
          </div>
          <div class="actions">
            <button class="btn-del" id="btn-delete-fields">
              <Icon width="20px" height="20px" name="mdi:trash" />borrar campos</button
            >

            <button class="btn-send">
              <Icon
                width="20px"
                height="20px"
                name="mdi:send"
                class="icon-animated"
              />Enviar</button
            >
          </div>
        </fieldset>
      </form>
    </div>
  </article>
</section>
<img
  src={BgTopContacto.src}
  alt="fondo ondulado"
  class="w-full absolute bottom-0"
/>

<style>
  .actions {
    display: flex;
    justify-items: stretch;
    gap: 10px;
    width: 100%;
  }
  .btn-send,
  .btn-del {
    overflow: hidden;
    width: 100%;
    height: 35px;
    display: flex;
    flex-direction: row-reverse;
    justify-content: center;
    align-items: center;
    gap: 15px;
    transition: 0.5s ease-in-out all;
  }
  .btn-send {
    color: white;
    background-color: rgb(17, 130, 127);
    &:hover {
      background-color: rgb(24, 168, 163);
      scale: 1.05;
    }
    &:hover > .icon-animated {
      animation: move 1s;
    }
  }

  @keyframes move {
    0% {
      transform: translateY(0px);
    }
    25% {
      transform: translateY(50px);
      opacity: 0;
    }
    50% {
      transform: translateY(-100px);
      opacity: 0;
    }
    100% {
      transform: translateY(0px);
    }
  }

  #Reservas {
    position: relative;
    background: linear-gradient(#fff, #e4e2e2);
    padding: 5rem;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
    height: 100dvh;
  }
  .title-reservas {
    font-size: 6rem;
  }
  .image {
    width: 500px;
    background-color: red;

    img {
      object-fit: cover;
      width: 100%;
      height: 100%;
    }
  }

  .content-reservas {
    z-index: 10;
    display: grid;
    grid-template-columns: 500px 1fr;
    background-color: rgba(250, 250, 250, 0.7);
    border-radius: 10px;
    align-content: stretch;
    backdrop-filter: blur(10px);
    width: 80%;
    box-shadow: 0 0 55px rgba(1, 1, 1, 0.2);
    h1 {
      text-align: center;
      font-family: var(--var-font-title);
      color: var(--var-color-green700);
    }
  }
  .form-contact {
    padding: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }
  .info-reserva {
    display: grid;
    justify-content: center;
    align-items: center;
    grid-template-columns: 1fr 1fr;
    width: 100%;
    gap: 5px;
    padding: 15px;
  }

  fieldset {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-content: stretch;
  }

  .input-container {
    position: relative;
    margin: 15px 0px;
    width: 100%;
  }
  input:focus {
    outline: none;
  }
  input,
  textarea {
    background-color: var(--var-color-white);
    border-radius: 3px;
    width: 100%;
    padding: 10px 5px;
    border: none;
    padding-left: 50px;
    color: var(--var-color-grey200);
  }
  textarea {
    height: 300px;
  }
  .input-container label {
    position: absolute;
    top: 8px;
    left: 50px;
    color: var(--var-color-green500);
    transition: 0.5s ease;
  }
  input:valid ~ label,
  input:focus ~ label,
  textarea:focus ~ label,
  textarea:valid ~ label {
    top: -27px;
    left: 0;
    color: var(--var-color-green500);
    font-size: 0.9em;
  }
  input:valid ~ .absolute top-0 left-0 m-2,
  textarea:focus ~ .absolute top-0 left-0 m-2,
  input:focus ~ .absolute top-0 left-0 m-2 {
    color: var(--var-color-green200);
    border-color: var(--var-color-green200);
  }
  .icon {
    position: absolute;
    top: 6px;
    left: 6px;
    color: var(--var-color-green400);
  }
  .botonera {
    display: flex;
  }
  .submit-message {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    border: none;
    width: 100%;
    gap: 15px;
    height: 60px;
    font-weight: 500;
    color: var(--var-color-white);
    padding: 15px 15px;
    transition: 0.5s ease-in-out;
    &:nth-child(even) {
      background-color: var(--var-color-secondary);
      &:hover {
        background-color: var(--var-color-secondary100);
      }
    }
    &:nth-child(odd) {
      background-color: var(--var-color-green500);
      &:hover {
        background-color: var(--var-color-green700);
      }
    }
  }
  @media (max-width: 1360px) {
    .image {
      width: 250px;
      img {
        object-fit: cover;
        width: 100%;
        height: 100%;
      }
    }
    .content-reservas {
      z-index: 10;
      display: grid;
      grid-template-columns: 250px 1fr;
      background-color: rgba(250, 250, 250, 0.8);
      border-radius: 10px;
      align-content: stretch;
      backdrop-filter: blur(10px);
      width: 100%;

      box-shadow: 0 0 55px rgba(1, 1, 1, 0.2);
      h1 {
        padding: 1rem;
        line-height: 3rem;
        text-align: center;
        font-family: var(--var-font-title);
        color: var(--var-color-green700);
      }
    }
  }
  @media (max-width: 680px) {
    #Reservas {
      height: fit-content;
      .form-contact {
        background-color: var(--var-color-grey000);
        display: flex;
        padding: 2rem;
        width: 90%;
        flex-wrap: auto;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      }
      .input-container {
        margin: 0.5rem;
        width: auto;
        justify-content: center;
        align-items: center;
      }
      textarea {
        margin: 0.1rem;
        border: 2px solid red;
      }
    }
  }
</style>
