---
const finicio_vig = "01-01-2025";
const ffinal_vig = "30-06-2025";
import { Icon } from "astro-icon/components";
---

<section id="Tarifas">
  <picture class="w-full">
    <img src="images/aparts_011.jpg" alt="" class="image-header" />
  </picture>
  <h1 class="titulo-tarifas">Tarifas</h1>
  <article class="container-tarifas">
    <div class="card">
      <img
        src="/images/aparts_001.jpg"
        class="card-image-header object-cover"
        alt=""
      />
      <h1 class="card-title">Aparts para 2 Personas</h1>

      <div class="card-content">
        <div class="flex">
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
        </div>
        <p>Valor</p>
        <p class="">Precio por noche</p>
        <p class="">$150.000</p>
        <p>Frente al mar</p>
        <button class="btn">Quiero saber mas...</button>
      </div>
    </div>
    <div class="card">
      <img
        src="/images/aparts_003.jpg"
        class="card-image-header object-cover"
        alt=""
      />
      <h1 class="card-title">Aparts para 3 Personas</h1>

      <div class="card-content">
        <div class="flex">
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
        </div>
        <p>Valor</p>
        <p class="">Precio por noche</p>
        <p class="">$150.000</p>
        <p>Frente al mar</p>
        <button class="btn">Quiero saber mas...</button>
      </div>
    </div>
    <div class="card">
      <img
        src="/images/aparts_002.jpg"
        class="card-image-header object-cover"
        alt=""
      />
      <h1 class="card-title">Aparts para 4 Personas</h1>

      <div class="card-content">
        <div class="flex">
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
        </div>
        <p>Valor</p>
        <p class="">Precio por noche</p>
        <p class="">$150.000</p>
        <p>Frente al mar</p>
        <button class="btn">Quiero saber mas...</button>
      </div>
    </div>
    <div class="card">
      <img
        src="/images/aparts_005.jpg"
        class="card-image-header object-cover"
        alt=""
      />
      <h1 class="card-title">Aparts para 4 Personas</h1>

      <div class="card-content">
        <div class="flex">
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
        </div>
        <p>Valor</p>
        <p class="">Precio por noche</p>
        <p class="">$150.000</p>
        <p>Frente al mar</p>
        <button class="btn">Quiero saber mas...</button>
      </div>
    </div>
  </article>
  <div class="leyenda">
    <p>
      Precios Vigentes desde {finicio_vig} hasta el {ffinal_vig}
    </p>
    <span>Tarifa por noche de alojamiento, expresada en moneda local</span>
  </div>
</section>
<style>
  #Tarifas {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100vh;
    background-color: #fff;
  }
  .titulo-tarifas {
    margin-top: 7rem;
    color: #fff;
    font-family: var(--var-font-title);
    font-size: 10rem;
    z-index: 10;
  }
  .container-tarifas {
    background-color: var(--var-color-white);
    margin: 0 auto;
    width: clamp(90%, 90%, 20%);
    display: flex;
    justify-content: center;
  }
  .bg_svg {
    top: 0;
    left: 0;
    position: absolute;
    object-fit: cover;
    width: 100%;
    height: 100vh;
  }
  .card {
    scale: 0.9;
    border: 10px solid white;
    width: 25%;
    height: 600px;
    background-color: #fff;
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 0 100px rgba(1, 1, 1, 0.2);
    transition: 0.5s all ease-in-out;
    cursor: pointer;
    &:hover {
      scale: 1.1;
      z-index: 12;
    }
  }
  .image-header {
    top: 0;
    position: absolute;
    width: 100%;
    height: 25%;
    object-fit: cover;
  }
  .card-image-header {
    position: absolute;
    width: 100%;
    top: 0;
    left: 0;
    border-radius: 0 0 25% 25%;
  }
  .card-content {
    width: 100%;
    position: absolute;
    top: 250px;
    z-index: 10;
    padding: 1rem;
    display: flex;
    background-color: #fff;
    flex-direction: column;
    align-items: center;
  }
  .card-title {
    top: 200px;
    left: 50%;
    transform: translateX(-50%);
    position: absolute;
    z-index: 2;
    width: clamp(90%, 45%, 100%);
    z-index: 10;
    background-color: #fff;
    padding: 1rem 0.25rem;
    border-radius: 25px 25px 0 0;
    text-align: center;
    color: var(--var-color-green500);
    font-size: 1.5em;
  }
  .btn {
    background-color: rgb(72, 196, 196);
    margin: 1rem 2rem;
    padding: 1rem 2rem;
    border-radius: 5px;
    color: white;
    transition: 0.5s all ease-in-out;
    &:hover {
      background-color: rgb(190, 248, 248);
      color: rgb(53, 150, 150);
    }
  }

  @media (max-width: 1024px) {
    #tarifas {
      width: 100dvh;
      overflow: hidden;
    }
    .container-tarifas {
      flex-direction: column;
      height: max-content;
    }
    .card {
      width: 90%;
      height: 250px;
    }
    .card-image-header {
      position: relative;
      display: none;
    }
    .card-title {
      position: relative;
    }
    .card-content {
      position: relative;
    }

    #Tarifas {
      min-height: fit-content;
      justify-content: center;

      p {
        letter-spacing: 0px;
      }
      span {
        letter-spacing: 1px;
        margin-top: 0.4rem;
        font-size: 1rem;
      }
      .leyenda {
        p {
          font-size: 0.75rem;
        }
        span {
          text-align: center;
          font-size: 0.8rem;
          width: 30%;
        }
      }
    }
  }
</style>
