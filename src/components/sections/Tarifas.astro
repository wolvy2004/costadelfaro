---
const finicio_vig = "01-01-2025";
const ffinal_vig = "30-06-2025";
import { Icon } from "astro-icon/components";
---

<section id="Tarifas">
  <article class="container">
    <picture class="w-full">
      <img src="images/aparts_011.jpg" alt="" class="h-48" />
    </picture>
    <h1>Tarifas</h1>
    <div class="flex gap-10 justify-center">
      <div class="card">
        <img
          src="/images/aparts_001.jpg"
          class="h-96 card-image-header object-cover"
          alt=""
        />
        <h1 class="card-title">Aparts para 4 Personas</h1>

        <div class="card-content">
          <div class="flex">
            <Icon name="mdi:account" width="32" height="32" />
            <Icon name="mdi:account" width="32" height="32" />
            <Icon name="mdi:account" width="32" height="32" />
            <Icon name="mdi:account" width="32" height="32" />
          </div>
          <p>Valor</p>
          <p class="text-2xl text-gray-400">Precio por noche</p>
          <p class="text-6xl font-bold tracking-[.01rem] inline">$150.000</p>
          <p>Frente al mar</p>
        </div>
      </div>
    </div>
    <div class="leyenda">
      <p>
        Precios Vigentes desde {finicio_vig} hasta el {ffinal_vig}
      </p>
      <span>Tarifa por noche de alojamiento, expresada en moneda local</span>
    </div>
  </article>
</section>
<style>
  #Tarifas {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100vh;
    background-color: #73d0c8;
  }
  .container {
    background-color: var(--var-color-white);
    margin: 0 auto;
  }

  .bg_svg {
    top: 0;
    left: 0;
    position: absolute;
    object-fit: cover;
    width: 100%;
    height: 100vh;
  }
  .card {
    border: 10px solid white;
    width: 20%;
    position: relative;

    height: 500px;
    background-color: #f4f4f4;
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 0 100px rgba(1, 1, 1, 0.2);
  }
  .card-image-header {
    position: absolute;
    width: 100%;
    top: 0;
    left: 0;
    border-radius: 0 0 25% 25%;
  }
  .card-content {
    position: absolute;
    top: 250px;
    z-index: 10;
    box-shadow: 0px -10px 25px rgba(1, 1, 1, 0.2);
    padding: 1rem;
    display: flex;
    background-color: #f1f1f1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .card-title {
    top: 200px;
    position: absolute;
    z-index: 2;
    width: clamp(90%, 45%, 100%);
    z-index: 10;
    background-color: #f4f4f4;
    padding: 1rem 0.25rem;
    border-radius: 25px 25px 0 0;
    text-align: center;
    color: var(--var-color-green500);
    font-size: 1.25em;
  }

  @media (max-width: 1024px) {
    #Tarifas {
      min-height: fit-content;
      justify-content: center;

      .img-lat-izq {
        display: none;
      }
      .container {
        width: 100%;
      }
      table {
        width: 100%;
        min-height: auto;
      }
      tr {
        width: 80%;
      }
      .icon-user {
        display: none;
      }
      .detalle {
        width: 100%;
      }
      .precio {
        width: 30%;
      }
      p {
        letter-spacing: 0px;
      }
      span {
        letter-spacing: 1px;
        margin-top: 0.4rem;
        font-size: 1rem;
      }
      .leyenda {
        p {
          font-size: 0.75rem;
        }
        span {
          text-align: center;
          font-size: 0.8rem;
          width: 30%;
        }
      }
    }
  }
</style>
