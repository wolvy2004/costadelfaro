---
const finicio_vig = "01-01-2025";
const ffinal_vig = "30-06-2025";
import { Icon } from "astro-icon/components";
---

<section id="Tarifas">
  <picture class="w-full">
    <img src="images/aparts_011.jpg" alt="" class="image-header" />
  </picture>
  <h1 class="titulo-tarifas">Tarifas</h1>
  <article class="container-tarifas">
    <div class="card">
      <img
        src="/images/aparts_001.jpg"
        class="card-image-header object-cover"
        alt=""
      />
      <h1 class="card-title">Aparts para 2 Personas</h1>

      <div class="card-content">
        <div class="flex">
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
        </div>

        <p class="desc-precio">Precio por noche</p>
        <p class="txt-precio">$150.000</p>
        <p>Frente al mar</p>
        <button class="btn">Reservar</button>
      </div>
    </div>
    <div class="card">
      <img
        src="/images/aparts_003.jpg"
        class="card-image-header object-cover"
        alt=""
      />
      <h1 class="card-title">Aparts para 3 Personas</h1>

      <div class="card-content">
        <div class="flex">
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
        </div>

        <p class="desc-precio">Precio por noche</p>
        <p class="txt-precio">$150.000</p>
        <p>Frente al mar</p>
        <button class="btn">Reservar</button>
      </div>
    </div>
    <div class="card">
      <img
        src="/images/aparts_002.jpg"
        class="card-image-header object-cover"
        alt=""
      />
      <h1 class="card-title">Aparts para 4 Personas</h1>

      <div class="card-content">
        <div class="flex">
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
        </div>

        <p class="desc-precio">Precio por noche</p>
        <p class="txt-precio">$150.000</p>
        <p>Frente al mar</p>
        <button class="btn">Reservar</button>
      </div>
    </div>
    <div class="card">
      <img
        src="/images/aparts_005.jpg"
        class="card-image-header object-cover"
        alt=""
      />
      <h1 class="card-title">Aparts para 4 Personas</h1>

      <div class="card-content">
        <div class="flex icons">
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
          <Icon name="mdi:account" width="32" height="32" />
        </div>

        <p class="desc-precio">Precio por noche</p>
        <p class="txt-precio">$150.000</p>
        <p>Frente al mar</p>
        <button class="btn">Reservar</button>
      </div>
    </div>
  </article>
  <div class="leyenda">
    <p>
      Precios Vigentes desde {finicio_vig} hasta el {ffinal_vig}
      -- <span>Tarifa por noche de alojamiento, expresada en moneda local</span>
    </p>
  </div>
</section>
<style>
  .icons {
  }
  .txt-precio {
    font-size: 5rem;
    font-weight: 900;
  }
  .desc-precio {
    font-size: 1.5rem;
    text-align: center;
    color: #777;
    margin-top: 1rem;
    line-height: 0.5rem;
    border-bottom: 1px solid #777;
    padding-bottom: 0.7rem;
    width: 50%;
  }
  #Tarifas {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: start;
    align-items: center;
    width: 100%;
    height: 100vh;
    background-color: #73d0c8;
  }
  .titulo-tarifas {
    margin-top: 7rem;
    line-height: 7rem;
    color: #fff;
    font-family: var(--var-font-title);
    font-size: 7rem;
    z-index: 10;
  }
  .container-tarifas {
    width: 70%;
    display: flex;
    align-content: stretch;
    justify-content: space-between;
  }
  .bg_svg {
    top: 0;
    left: 0;
    position: absolute;
    object-fit: cover;
    width: 100%;
    height: 100vh;
  }
  .card {
    width: 100%;
    position: relative;
    scale: 0.9;
    height: 600px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #fff;
    overflow: hidden;
    box-shadow: 0 0 100px rgba(1, 1, 1, 0.2);
    transition: 0.5s all ease-in-out;
    cursor: pointer;
    &:hover {
      scale: 1.05;
      z-index: 12;
    }
  }
  .image-header {
    top: 0;
    position: absolute;
    width: 100%;
    height: 30%;
    object-fit: cover;
  }
  .card-image-header {
    position: absolute;
    top: 0;
    left: 0;
    height: 360px;
  }
  .card-content {
    position: absolute;
    padding: 1rem;
    bottom: 2rem;
    width: 100%;
    z-index: 20;
    display: flex;
    background-color: #fff;
    flex-direction: column;
    align-items: center;
  }
  .card-title {
    color: white;
    text-align: center;
    z-index: 40;
    text-align: center;
    font-size: 2.2em;
  }
  .btn {
    font-size: 1.5rem;
    background-color: rgb(72, 196, 196);
    margin: 0.5rem 1rem;
    padding: 1rem 2rem;
    border-radius: 5px;
    color: white;
    transition: 0.5s all ease-in-out;
    &:hover {
      background-color: rgb(190, 248, 248);
      color: rgb(53, 150, 150);
    }
  }
  @media (max-width: 1360px) {
    .txt-precio {
      font-size: 3rem;
      font-weight: 900;
    }
    .desc-precio {
      text-align: center;
      color: #777;
      margin-top: 1rem;
      line-height: 0.5rem;
      border-bottom: 1px solid #777;
      padding-bottom: 0.7rem;
      width: 70%;
    }

    .titulo-tarifas {
      color: #fff;
      font-family: var(--var-font-title);
      font-size: 7rem;
      z-index: 10;
    }
    .container-tarifas {
      width: clamp(90%, 90%, 20%);
      display: flex;
      justify-content: center;
      align-items: start;
    }
    .bg_svg {
      top: 0;
      left: 0;
      position: absolute;
      object-fit: cover;
      width: 100%;
      height: 100vh;
    }
    .card {
      position: relative;
      scale: 0.9;
      display: flex;
      height: 450px;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      background-color: #fff;
      overflow: hidden;
      box-shadow: 0 0 100px rgba(1, 1, 1, 0.2);
      transition: 0.5s all ease-in-out;
      cursor: pointer;
      &:hover {
        scale: 1.05;
        z-index: 12;
      }
    }
    .image-header {
      top: 0;
      position: absolute;
      width: 100%;
      height: 30%;
      object-fit: cover;
    }
    .card-image-header {
      position: absolute;
      width: 100%;
      height: 260px;
      top: 0;
      left: 0;
    }
    .card-content {
      width: 100%;
      z-index: 40;
      padding: 0.5rem;
      display: flex;
      background-color: #fff;
      flex-direction: column;
      align-items: center;
    }
    .card-title {
      text-align: center;
      width: clamp(90%, 45%, 100%);
      margin-bottom: 25px;
      z-index: 40;
      padding: 0.5rem 0.25rem;
      text-align: center;
      color: white;
      font-size: 1.5em;
    }
    .btn {
      background-color: rgb(72, 196, 196);
      margin: 0.5rem 1rem;
      padding: 0.5rem 1rem;
      border-radius: 5px;
      color: white;
      transition: 0.5s all ease-in-out;
      &:hover {
        background-color: rgb(190, 248, 248);
        color: rgb(53, 150, 150);
      }
    }
  }
  .leyenda {
    p {
      font-size: .rem;
      color: #024e53;
    }
    span {
      text-align: center;

      width: 30%;
    }
  }

  @media (max-width: 1024px) {
    .titulo-tarifas {
      margin-top: 0.5rem;
      color: #fff;
      font-family: var(--var-font-title);
      font-size: 5rem;
      z-index: 10;
    }
    .image-header {
      top: 0;
      position: absolute;
      width: 100%;
      height: 10%;
      object-fit: cover;
    }
    #tarifas {
      width: 100dvh;
      overflow: hidden;
    }
    .container-tarifas {
      flex-direction: column;
      height: max-content;
    }
    .card {
      width: 90%;
      height: 250px;
    }
    .card-image-header {
      position: relative;
      display: none;
    }
    .card-title {
      position: relative;
    }
    .card-content {
      position: relative;
    }

    #Tarifas {
      min-height: fit-content;
      justify-content: center;

      p {
        letter-spacing: 0px;
      }
      span {
        letter-spacing: 1px;
        margin-top: 0.4rem;
        font-size: 1rem;
      }
    }
  }
</style>
